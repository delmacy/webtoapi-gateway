# ============================================================
# WebToAPI Gateway — environment variable configuration
# All variables use the TFG_ prefix to preserve upstream compatibility.
#
# Alternatively, you can put these settings in:
#   ~/.token-free-gateway/config.json
#
# Priority: TFG_* env vars > config.json > built-in defaults
# ============================================================

# Gateway API key for client authentication (optional).
# Leave empty to disable auth (any client can connect).
TFG_API_KEY=

# Server listen port (default: 3456)
# TFG_PORT=3456

# Chrome debug port URL used for browser-side requests and webauth (default: http://127.0.0.1:9222)
# TFG_CDP_URL=http://127.0.0.1:9222

# Per-request timeout in seconds (default: 300)
# TFG_REQUEST_TIMEOUT_SEC=300

# ============================================================
# Agentic mode
# ============================================================

# optimized: context compaction + loop guard + fair-use scheduling
# passthrough: preserve the original upstream gateway behavior
# TFG_AGENT_MODE=optimized

# Logical task/session idle TTL. Sessions are in-memory and are used only for
# telemetry/loop detection/context accounting; provider login sessions remain
# managed by the existing adapters. Default: 3600 seconds.
# TFG_AGENT_SESSION_IDLE_TTL_SEC=3600

# Guard against runaway agent loops. Default: 40 tool-call turns.
# TFG_AGENT_MAX_TOOL_TURNS=40

# Stop when the exact same tool name+arguments occurs consecutively more than
# this number. Default: 2.
# TFG_AGENT_MAX_IDENTICAL_TOOL_CALLS=2

# Compact only OLD oversized tool results; recent messages stay verbatim.
# Default: 12000 characters per historical tool result.
# TFG_AGENT_TOOL_RESULT_MAX_CHARS=12000

# Number of newest messages that are never compacted. Default: 6.
# TFG_AGENT_PRESERVE_TAIL_MESSAGES=6

# Fair-use defaults: one active request per provider and a minimum interval
# between request starts. These are conservative client-side controls; provider
# 429/cooldown responses are never bypassed or hidden.
# TFG_AGENT_MAX_CONCURRENCY_PER_PROVIDER=1
# TFG_AGENT_MIN_INTERVAL_MS=2500

# Emit per-session context savings/turn metrics to the gateway log.
# TFG_AGENT_TELEMETRY=true

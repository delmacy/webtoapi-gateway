{
	"name": "token-free-gateway",
	"version": "0.5.2",
	"description": "Multi-provider OpenAI-compatible AI gateway powered by web sessions",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --hot index.ts",
		"start": "bun index.ts",
		"test": "bun test",
		"check": "bun x @biomejs/biome check --write .",
		"lint": "bun x @biomejs/biome lint .",
		"lint:fix": "bun x @biomejs/biome check --write --unsafe .",
		"format": "bun x @biomejs/biome format --write .",
		"typecheck": "bun x tsc --noEmit",
		"webauth": "bun index.ts webauth",
		"e2e:deepseek-stateful": "bun scripts/e2e-deepseek-stateful.ts",
		"e2e:deepseek-isolation": "bun scripts/e2e-deepseek-isolation.ts",
		"e2e:chatgpt-stateful": "bun scripts/e2e-chatgpt-stateful.ts",
		"e2e:chatgpt-dom-isolation": "bun scripts/e2e-chatgpt-dom-isolation.ts",
		"e2e:qwen-stateful": "bun scripts/e2e-qwen-stateful.ts",
		"e2e:qwen-isolation": "bun scripts/e2e-qwen-isolation.ts",
		"e2e:kimi-stateful": "bun scripts/e2e-kimi-stateful.ts",
		"e2e:kimi-isolation": "bun scripts/e2e-kimi-isolation.ts",
		"build": "bun build index.ts --compile --external chromium-bidi --external electron --outfile token-free-gateway",
		"bump": "bun scripts/bump-version.ts",
		"bump:patch": "bun scripts/bump-version.ts patch",
		"bump:minor": "bun scripts/bump-version.ts minor",
		"bump:major": "bun scripts/bump-version.ts major",
		"postinstall": "bun scripts/postinstall.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"playwright-core": "^1.59.1"
	}
}
